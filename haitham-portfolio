<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haitham Abdulmajeed — Data Analyst</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0F1319;
    --surface: #161B22;
    --surface-raised: #1D2530;
    --border: #2A323D;
    --text: #E7E9ED;
    --text-muted: #8D96A6;
    --accent: #D9A441;
    --accent-2: #4E9E97;
    --danger: #C1544C;
    --sans: 'IBM Plex Sans', -apple-system, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --max: 1080px;
  }

  *{ box-sizing: border-box; margin: 0; padding: 0; }

  html{ scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior: auto; } }

  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: inherit; text-decoration: none; }
  a:focus-visible, button:focus-visible{ outline: 2px solid var(--accent); outline-offset: 3px; }

  .wrap{ max-width: var(--max); margin: 0 auto; padding: 0 28px; }

  /* ---------- NAV ---------- */
  header{
    position: sticky; top: 0; z-index: 20;
    background: rgba(15,19,25,0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  nav.wrap{
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .brand{ font-weight: 600; font-size: 15px; letter-spacing: 0.2px; }
  .brand span{ color: var(--text); }
  .navlinks{ display: flex; gap: 28px; font-size: 14px; color: var(--text-muted); }
  .navlinks a:hover{ color: var(--text); }
  @media (max-width: 640px){ .navlinks{ display: none; } }

  /* ---------- HERO ---------- */
  .hero{
    padding: 76px 0 64px;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid{
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 800px){ .hero-grid{ grid-template-columns: 1fr; gap: 36px; } }

  .eyebrow{
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--accent-2);
    margin-bottom: 14px;
  }
  h1{
    font-size: clamp(32px, 4.6vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 12ch;
    opacity: 0;
    animation: rise 0.6s ease forwards;
  }
  .hero p.lead{
    margin-top: 18px;
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 16.5px;
    opacity: 0;
    animation: rise 0.6s ease 0.12s forwards;
  }
  @keyframes rise{ from{ opacity: 0; transform: translateY(8px); } to{ opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce){ h1, .hero p.lead{ animation: none; opacity: 1; } }

  .contact-row{
    display: flex; flex-wrap: wrap; gap: 10px;
    margin-top: 28px;
  }
  .contact-row a, .contact-row span{
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 7px 12px;
    transition: border-color 0.15s, color 0.15s;
  }
  .contact-row a:hover{ border-color: var(--accent); color: var(--text); }

  /* KPI strip mirrors the dashboard-card language from the case studies themselves */
  .kpi-col{ display: flex; flex-direction: column; gap: 12px; }
  .kpi-card{
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px 20px;
  }
  .kpi-num{
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .kpi-card:nth-child(2) .kpi-num{ color: var(--accent-2); }
  .kpi-card:nth-child(3) .kpi-num{ color: var(--danger); }
  .kpi-label{
    margin-top: 7px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .kpi-source{
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 11px;
    color: #5D6675;
  }

  /* ---------- SECTION HEADINGS ---------- */
  section{ padding: 68px 0; border-bottom: 1px solid var(--border); }
  .sec-head{ max-width: 60ch; margin-bottom: 44px; }
  .sec-head h2{ font-size: 26px; font-weight: 600; }
  .sec-head p{ margin-top: 10px; color: var(--text-muted); font-size: 15px; }

  /* ---------- CASE STUDIES ---------- */
  .case{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 36px 0;
  }
  .case + .case{ border-top: 1px solid var(--border); }
  .case:nth-child(even) .case-media{ order: 2; }
  @media (max-width: 800px){
    .case{ grid-template-columns: 1fr; }
    .case:nth-child(even) .case-media{ order: 0; }
  }

  .case-media{
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    aspect-ratio: 16/10;
    display: flex; align-items: center; justify-content: center;
  }
  .case-media img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  .case-media.placeholder{
    flex-direction: column; gap: 8px;
    color: #4A5261;
    font-family: var(--mono);
    font-size: 13px;
    text-align: center;
    padding: 20px;
  }
  .case-media.placeholder .ph-mark{ font-size: 28px; color: var(--border); }

  .case-title{ font-size: 20px; font-weight: 600; }
  .case-title a{ border-bottom: 1px solid transparent; }
  .case-title a:hover{ border-color: var(--accent); color: var(--accent); }

  .case-q{
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--text-muted);
    border-left: 2px solid var(--accent-2);
    padding-left: 14px;
  }

  .case-stats{ display: flex; gap: 22px; margin-top: 18px; flex-wrap: wrap; }
  .case-stats div{ font-family: var(--mono); }
  .case-stats b{ display: block; font-size: 17px; color: var(--text); }
  .case-stats span{ font-size: 11.5px; color: var(--text-muted); }

  .tags{ display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .tag{
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 8px;
  }

  .case-link{
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 20px;
    font-size: 13.5px;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }
  .case-link:hover{ color: var(--accent); }

  /* ---------- EARLY WORK ---------- */
  .early-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 700px){ .early-grid{ grid-template-columns: 1fr; } }
  .early-tile{
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
  }
  .early-tile img{ width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; }
  .early-tile figcaption{ padding: 12px 14px 16px; }
  .early-tile b{ display: block; color: var(--text); font-size: 13.5px; margin-bottom: 4px; }
  .early-tile span{ color: var(--text-muted); font-size: 12px; line-height: 1.5; display: block; }

  /* ---------- ABOUT ---------- */
  .about-grid{ display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; }
  @media (max-width: 800px){ .about-grid{ grid-template-columns: 1fr; } }
  .about-grid p{ color: var(--text-muted); font-size: 15px; max-width: 56ch; }
  .about-grid p + p{ margin-top: 14px; }

  .skill-group{ margin-bottom: 20px; }
  .skill-group h4{ font-size: 12.5px; color: var(--text-muted); font-weight: 500; margin-bottom: 10px; }
  .skill-pills{ display: flex; flex-wrap: wrap; gap: 7px; }
  .skill-pills span{
    font-family: var(--mono); font-size: 12px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 4px; padding: 5px 9px; color: var(--text);
  }

  .timeline{ margin-top: 26px; }
  .tl-item{ display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 0; border-top: 1px solid var(--border); }
  .tl-item:first-child{ border-top: none; }
  .tl-date{ font-family: var(--mono); font-size: 11.5px; color: var(--text-muted); padding-top: 2px; }
  .tl-role{ font-size: 14px; }
  .tl-role b{ display: block; font-weight: 600; }
  .tl-role span{ color: var(--text-muted); font-size: 13px; }

  /* ---------- FOOTER ---------- */
  footer{ padding: 44px 0 60px; }
  .footer-grid{ display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; }
  footer .contact-row{ margin-top: 0; }
  .foot-note{ font-size: 12.5px; color: #5D6675; }
</style>
